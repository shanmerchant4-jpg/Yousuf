# Postgres connection string (Neon free tier recommended).
# Get one free at https://neon.tech -> create project -> copy "Connection string".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign login sessions. Generate any long random string.
# e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Secret token the daily cron must send (so randoms can't trigger it).
# Generate same way as AUTH_SECRET.
CRON_SECRET="change-me-too"

# Days after due date before a customer is auto-marked SUSPENDED.
GRACE_DAYS="3"
